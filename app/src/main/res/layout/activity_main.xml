<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kame_house_background" 
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:gravity="center"
        android:padding="10dp"
        android:text="Cuộc đua kỳ thú"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/scoreLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvScore1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"/>

        <TextView
            android:id="@+id/tvScore2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"/>

        <TextView
            android:id="@+id/tvScore3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/image_goku"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/p2"
        app:layout_constraintBottom_toTopOf="@id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp" />

    <ImageView
        android:id="@+id/image_vegeta"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/p1"
        app:layout_constraintBottom_toTopOf="@id/image_goku"
        app:layout_constraintStart_toStartOf="@id/image_goku"/>

    <ImageView
        android:id="@+id/img3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/p3"
        app:layout_constraintBottom_toTopOf="@id/image_vegeta"
        app:layout_constraintStart_toStartOf="@id/image_vegeta"/>

    <CheckBox
        android:id="@+id/cb3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/img3"
        app:layout_constraintBottom_toBottomOf="@+id/img3"
        app:layout_constraintStart_toEndOf="@+id/img3"
        android:layout_marginStart="8dp"/>

    <CheckBox
        android:id="@+id/cb2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/image_vegeta"
        app:layout_constraintBottom_toBottomOf="@+id/image_vegeta"
        app:layout_constraintStart_toEndOf="@+id/image_vegeta"
        android:layout_marginStart="8dp"/>

    <CheckBox
        android:id="@+id/cb1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/image_goku"
        app:layout_constraintBottom_toBottomOf="@+id/image_goku"
        app:layout_constraintStart_toEndOf="@+id/image_goku"
        android:layout_marginStart="8dp"/>

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nguyễn Tiến Dũng - PM27.03"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#80000000"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>